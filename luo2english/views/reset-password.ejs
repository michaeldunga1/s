<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <meta name="theme-color" content="#684728">
  <link rel="stylesheet" href="/css/style.css">
  <%- include('partials/adsense-head') %>
</head>
<body>
  <%- include('partials/navbar', { user }) %>

  <div class="container">
    <div style="max-width: 400px; margin: 3rem auto;">
      <div class="card">
        <div class="card-header">Reset Password</div>

        <% if (errors && errors.length > 0) { %>
          <% errors.forEach(error => { %>
            <div class="alert alert-error"><%= error %></div>
          <% }); %>
        <% } %>

        <% if (invalid) { %>
          <p style="margin-top: 1rem; text-align: center; color: #666;">
            <a href="/auth/forgot-password" style="color: #D4A574;">Request a new reset link</a>
          </p>
        <% } else { %>
          <form method="POST" action="/auth/reset-password">
            <input type="hidden" name="token" value="<%= token %>">

            <div class="form-group">
              <label for="password">New password</label>
              <div class="password-field">
                <input
                  type="password"
                  id="password"
                  name="password"
                  autocomplete="new-password"
                  minlength="8"
                  required
                >
                <button type="button" class="password-toggle" data-toggle-password="password" aria-label="Show password" aria-pressed="false" aria-controls="password">
                  <svg class="icon" aria-hidden="true"><use href="/icons.svg#eye"></use></svg>
                </button>
              </div>
              <small style="color: #666;">At least 8 characters</small>
            </div>

            <div class="form-group">
              <label for="confirm_password">Confirm new password</label>
              <div class="password-field">
                <input
                  type="password"
                  id="confirm_password"
                  name="confirm_password"
                  autocomplete="new-password"
                  minlength="8"
                  required
                >
                <button type="button" class="password-toggle" data-toggle-password="confirm_password" aria-label="Show password" aria-pressed="false" aria-controls="confirm_password">
                  <svg class="icon" aria-hidden="true"><use href="/icons.svg#eye"></use></svg>
                </button>
              </div>
            </div>

            <button type="submit" class="btn btn-primary" style="width: 100%;">Reset password</button>
          </form>

          <p style="margin-top: 1rem; text-align: center; color: #666;">
            <a href="/auth/login" style="color: #D4A574;">Back to login</a>
          </p>
        <% } %>
      </div>
    </div>
  </div>

  <%- include('partials/ad-footer') %>
  <%- include('partials/legal-footer') %>

  <script src="/js/password-toggle.js"></script>
</body>
</html>
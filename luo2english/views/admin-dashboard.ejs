<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
  <%- include('partials/adsense-head') %>
</head>
<body>
  <%- include('partials/navbar', { user }) %>

  <div class="container">
    <%- include('partials/flash') %>
    <div class="admin-header">
      <h1 class="admin-title">Admin Dashboard</h1>
      <a href="/admin/words/new" class="btn btn-primary"><svg class="icon btn-icon" aria-hidden="true"><use href="/icons.svg#plus"></use></svg> Add Word</a>
    </div>

    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-number"><%= stats.totalWords %></div>
        <div class="stat-label">Words</div>
      </div>
      <div class="stat-card">
        <div class="stat-number"><%= stats.totalDefinitions %></div>
        <div class="stat-label">Definitions</div>
      </div>
      <div class="stat-card">
        <div class="stat-number"><%= stats.totalUsers %></div>
        <div class="stat-label">Users</div>
      </div>
      <div class="stat-card">
        <div class="stat-number"><%= stats.totalComments %></div>
        <div class="stat-label">Comments</div>
      </div>
    </div>

    <div class="card">
      <div class="card-header">Quick Links</div>
      <ul class="quick-links">
        <li><a href="/admin/words" class="btn-link" style="color: #D4A574;"><svg class="icon action-icon" aria-hidden="true"><use href="/icons.svg#list"></use></svg> Manage Words</a></li>
        <li><a href="/admin/words/batch" class="btn-link" style="color: #D4A574;"><svg class="icon action-icon" aria-hidden="true"><use href="/icons.svg#list-plus"></use></svg> Batch Add Words</a></li>
        <li><a href="/admin/words/cleanup" class="btn-link" style="color: #C9453A;"><svg class="icon action-icon" aria-hidden="true"><use href="/icons.svg#trash"></use></svg> Remove Non-Alphabetic Words</a></li>
        <li><a href="/admin/schema" class="btn-link" style="color: #D4A574;"><svg class="icon action-icon" aria-hidden="true"><use href="/icons.svg#dictionary"></use></svg> Database Schema</a></li>
        <li><a href="/admin/users" class="btn-link" style="color: #D4A574;"><svg class="icon action-icon" aria-hidden="true"><use href="/icons.svg#conversation"></use></svg> Manage Users</a></li>
      </ul>
    </div>

    <div class="card">
      <div class="card-header">Cleanup</div>
      <form method="POST" action="/admin/words/cleanup-non-alphabetic" style="display: inline;">
        <button type="submit" class="btn btn-danger" onclick="return confirm('Delete all words starting or ending with non-alphabetic characters? This cannot be undone.')"><svg class="icon btn-icon" aria-hidden="true"><use href="/icons.svg#trash"></use></svg> Cleanup Non-Alphabetic Words</button>
      </form>
    </div>
  </div>

  <%- include('partials/ad-footer') %>
  <%- include('partials/legal-footer') %>

  <script src="/js/app.js"></script>
</body>
</html>
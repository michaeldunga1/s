<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="container">
      <div class="navbar-brand">
        <a href="/" class="logo"><svg class="icon brand-icon" aria-hidden="true"><use href="/icons.svg#dictionary"></use></svg> Luo2English</a>
      </div>
      <ul class="navbar-menu">
        <li><a href="/">Dictionary</a></li>
        <% if (user) { %>
          <% if (user.role === 'admin') { %>
            <li><a href="/admin">Admin</a></li>
            <li><a href="/admin/users">Users</a></li>
          <% } %>
          <li><a href="/profile">Profile</a></li>
          <li><span class="navbar-user">Hello, <%= user.username %></span></li>
          <li><a href="/auth/logout" class="btn-logout">Logout</a></li>
        <% } else { %>
          <li><a href="/auth/login" class="btn-nav">Login</a></li>
          <li><a href="/auth/register" class="btn-nav btn-nav-primary">Register</a></li>
        <% } %>
      </ul>
    </div>
  </nav>

  <div class="container">
    <div class="admin-header">
      <h1 class="admin-title">Admin Dashboard</h1>
      <a href="/admin/words/new" class="btn btn-primary">+ Add Word</a>
    </div>

    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-number"><%= stats.totalWords %></div>
        <div class="stat-label">Words</div>
      </div>
      <div class="stat-card">
        <div class="stat-number"><%= stats.totalDefinitions %></div>
        <div class="stat-label">Definitions</div>
      </div>
      <div class="stat-card">
        <div class="stat-number"><%= stats.totalUsers %></div>
        <div class="stat-label">Users</div>
      </div>
      <div class="stat-card">
        <div class="stat-number"><%= stats.totalComments %></div>
        <div class="stat-label">Comments</div>
      </div>
    </div>

    <div class="card">
      <div class="card-header">Quick Links</div>
      <ul style="list-style: none;">
        <li><a href="/admin/words" class="btn-link" style="color: #D4A574;">Manage Words</a></li>
        <li><a href="/admin/schema" class="btn-link" style="color: #D4A574;">Database Schema</a></li>
        <li><a href="/admin/users" class="btn-link" style="color: #D4A574;">Manage Users</a></li>
      </ul>
    </div>
  </div>

  <%- include('partials/legal-footer') %>
</body>
</html>

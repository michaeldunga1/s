<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <meta name="theme-color" content="#684728">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="container">
      <div class="navbar-brand">
        <a href="/" class="logo"><svg class="icon brand-icon" aria-hidden="true"><use href="/icons.svg#dictionary"></use></svg> Luo2English</a>
      </div>
      <ul class="navbar-menu">
        <li><a href="/">Dictionary</a></li>
        <% if (user) { %>
          <% if (user.role === 'admin') { %>
            <li><a href="/admin">Admin</a></li>
            <li><a href="/admin/users">Users</a></li>
          <% } %>
          <li><a href="/profile">Profile</a></li>
          <li><span class="navbar-user">Hello, <%= user.username %></span></li>
          <li><a href="/auth/logout" class="btn-logout">Logout</a></li>
        <% } else { %>
          <li><a href="/auth/login" class="btn-nav">Login</a></li>
          <li><a href="/auth/register" class="btn-nav btn-nav-primary">Register</a></li>
        <% } %>
      </ul>
    </div>
  </nav>

  <div class="container">
    <div style="max-width: 400px; margin: 3rem auto;">
      <div class="card">
        <div class="card-header">Forgot Password</div>

        <% if (sent) { %>
          <div class="alert alert-success">
            If an account exists for that email, a password reset link has been sent.
            The link expires in 1 hour.
          </div>
        <% } %>

        <% if (errors && errors.length > 0) { %>
          <% errors.forEach(error => { %>
            <div class="alert alert-error"><%= error %></div>
          <% }); %>
        <% } %>

        <% if (!sent) { %>
          <form method="POST" action="/auth/forgot-password">
            <div class="form-group">
              <label for="email">Email</label>
              <input
                type="email"
                id="email"
                name="email"
                value="<%= email || '' %>"
                autocomplete="email"
                maxlength="254"
                required
              >
              <small style="color: #666;">Enter the email address for your account</small>
            </div>

            <button type="submit" class="btn btn-primary" style="width: 100%;">Send reset link</button>
          </form>
        <% } %>

        <p style="margin-top: 1rem; text-align: center; color: #666;">
          Remembered your password? <a href="/auth/login" style="color: #D4A574;">Log in</a>
        </p>
      </div>
    </div>
  </div>

  <%- include('partials/legal-footer') %>
</body>
</html>

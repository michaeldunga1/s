<div class="dictionary-hero">
  <div>
    <p class="hero-eyebrow">Language & community</p>
    <h1>Luo to English Dictionary</h1>
    <p>Browse Luo words and their English definitions with community comments.</p>
  </div>
  <div class="hero-illustration" aria-hidden="true"><svg class="icon"><use href="/icons.svg#dictionary"></use></svg></div>
</div>

<% if (!query || query.length < 3) { %>
  <!-- Header Ad Slot (only on main page, not search results) -->
  <%- include('partials/ad-header') %>
<% } %>

<form method="get" action="/" class="dictionary-search">
  <label for="dictionary-search">Search Luo words and English definitions</label>
  <div class="search-controls"><input id="dictionary-search" type="search" name="q" value="<%= query %>" maxlength="200" placeholder="Search dictionary"><button class="btn" type="submit">Search</button><% if (query) { %><a href="/">Clear</a><% } %></div>
</form>
<% if (words.length === 0) { %>
  <div class="card">
    <p style="text-align: center; color: #666;"><%= query ? 'No matching words found.' : 'No words available yet.' %></p>
  </div>
<% } else { %>
  <p class="pagination-summary" role="status">
    <svg class="icon pagination-icon" aria-hidden="true"><use href="/icons.svg#list"></use></svg>
    <span>Showing <%= pagination.firstItem %>–<%= pagination.lastItem %> of <%= pagination.totalItems %> word<%= pagination.totalItems === 1 ? '' : 's' %><% if (query) { %> matching <%= query %><% } %>.</span>
  </p>
  <div class="words-list">
    <% words.forEach((word, index) => { %>
      <% if (index > 0 && index % 10 === 0) { %>
        <!-- In-content Ad Slot -->
        <div class="ad-slot ad-in-content">
          <ins class="adsbygoogle"
               style="display:block"
               data-ad-client="ca-pub-XXXXXXXXXXXXXXXX"
               data-ad-slot="XXXXXXXXXX"
               data-ad-format="fluid"
               data-full-width-responsive="true"></ins>
          <script>
            (adsbygoogle = window.adsbygoogle || []).push({});
          </script>
        </div>
      <% } %>
      <a href="/word/<%= word.id %>" class="word-link">
        <span class="word-text"><%= word.word %></span>
        <% if (word.definition) { %>
          <span class="word-definition"><%= word.definition %></span>
        <% } else { %>
          <span class="word-no-definition">No definition</span>
<% } %>
<%- include('partials/ad-footer') %>
<%- include('partials/legal-footer') %>
      </a>
    <% }); %>
  </div>
  <%- include('partials/pagination', { pagination, pageUrl }) %>
<% } %>
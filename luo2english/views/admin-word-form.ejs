<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
  <%- include('partials/adsense-head') %>
</head>
<body>
  <%- include('partials/navbar', { user }) %>

  <div class="container">
    <%- include('partials/flash') %>
    <div style="max-width: 500px; margin: 2rem auto;">
      <div class="card">
        <div class="card-header"><%= title %></div>

        <% if (errors && errors.length > 0) { %>
          <% errors.forEach(error => { %>
            <div class="alert alert-error"><%= error %></div>
          <% }); %>
        <% } %>

        <form method="POST" action="<%= word && word.id ? `/admin/words/${word.id}` : `/admin/words` %>">
          <div class="form-group">
            <label for="word">Word (Luo)</label>
            <input type="text" id="word" name="word" value="<%= word?.word || '' %>" maxlength="100" required autocomplete="off">
          </div>
          <div class="form-group">
            <label for="definition">Definition (English)</label>
            <textarea id="definition" name="definition" rows="6" maxlength="5000"><%= word?.definition || '' %></textarea>
          </div>
          <button type="submit" class="btn btn-primary">Save Word</button>
          <a href="/admin/words" class="btn btn-secondary">Cancel</a>
        </form>
      </div>
    </div>
  </div>

  <%- include('partials/ad-footer') %>
  <%- include('partials/legal-footer') %>

  <script src="/js/app.js"></script>
</body>
</html>
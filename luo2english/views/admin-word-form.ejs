<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="container">
      <div class="navbar-brand"><a href="/" class="logo"><svg class="icon brand-icon" aria-hidden="true"><use href="/icons.svg#dictionary"></use></svg> Luo2English</a></div>
      <ul class="navbar-menu">
        <li><a href="/">Dictionary</a></li>
        <li><a href="/admin">Admin</a></li>
        <li><a href="/admin/users">Users</a></li>
        <li><a href="/profile">Profile</a></li>
        <li><span class="navbar-user">Hello, <%= user.username %></span></li>
        <li><a href="/auth/logout" class="btn-logout">Logout</a></li>
      </ul>
    </div>
  </nav>

  <div class="container">
    <div style="max-width: 500px; margin: 2rem auto;">
      <div class="card">
        <div class="card-header"><%= title %></div>

        <% if (errors && errors.length > 0) { %>
          <% errors.forEach(error => { %>
            <div class="alert alert-error"><%= error %></div>
          <% }); %>
        <% } %>

        <form method="POST" action="<%= word && word.id ? `/admin/words/${word.id}` : `/admin/words` %>">
          <div class="form-group">
            <label for="word">Word (Luo)</label>
            <input type="text" id="word" name="word" value="<%= word?.word || '' %>" required>
          </div>
          <div class="form-group">
            <label for="definition">Definition (English)</label>
            <textarea id="definition" name="definition" rows="6"><%= word?.definition || '' %></textarea>
          </div>
          <button type="submit" class="btn btn-primary">Save Word</button>
          <a href="/admin/words" class="btn btn-secondary">Cancel</a>
        </form>
      </div>
    </div>
  </div>

  <%- include('partials/legal-footer') %>
</body>
</html>

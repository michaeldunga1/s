<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <meta name="theme-color" content="#684728">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="container">
      <div class="navbar-brand">
        <a href="/" class="logo"><svg class="icon brand-icon" aria-hidden="true"><use href="/icons.svg#dictionary"></use></svg> Luo2English</a>
      </div>
      <ul class="navbar-menu">
        <li><a href="/">Dictionary</a></li>
        <% if (user) { %>
          <% if (user.role === 'admin') { %>
            <li><a href="/admin">Admin</a></li>
            <li><a href="/admin/users">Users</a></li>
          <% } %>
          <li><a href="/profile">Profile</a></li>
          <li><span class="navbar-user">Hello, <%= user.username %></span></li>
          <li><a href="/auth/logout" class="btn-logout">Logout</a></li>
        <% } else { %>
          <li><a href="/auth/login" class="btn-nav">Login</a></li>
          <li><a href="/auth/register" class="btn-nav btn-nav-primary">Register</a></li>
        <% } %>
      </ul>
    </div>
  </nav>

  <div class="container">
    <div style="max-width: 400px; margin: 3rem auto;">
      <div class="card">
        <div class="card-header">Login</div>

        <% if (locals.success) { %>
          <div class="alert alert-success"><%= success %></div>
        <% } %>

        <% if (errors && errors.length > 0) { %>
          <% errors.forEach(error => { %>
            <div class="alert alert-error"><%= error %></div>
          <% }); %>
        <% } %>

        <form method="POST" action="/auth/login">
          <div class="form-group">
            <label for="username">Username</label>
            <input 
              type="text" 
              id="username" 
              name="username" 
              value="<%= username || '' %>"
              autocomplete="username"
              autocapitalize="none"
              spellcheck="false"
              maxlength="50"
              required
              autofocus
            >
          </div>

          <div class="form-group">
            <label for="password">Password</label>
            <div class="password-field">
              <input 
                type="password" 
                id="password" 
                name="password" 
                autocomplete="current-password"
                required
              >
              <button type="button" class="password-toggle" data-toggle-password="password" aria-label="Show password" aria-pressed="false" aria-controls="password">
                <svg class="icon" aria-hidden="true"><use href="/icons.svg#eye"></use></svg>
              </button>
            </div>
          </div>

          <button type="submit" class="btn btn-primary" style="width: 100%;">Login</button>
        </form>

        <p style="margin-top: 0.75rem; text-align: center; color: #666;">
          <a href="/auth/forgot-password" style="color: #D4A574;">Forgot your password?</a>
        </p>

        <p style="margin-top: 1rem; text-align: center; color: #666;">
          Don't have an account? <a href="/auth/register" style="color: #D4A574;">Register here</a>
        </p>
      </div>
    </div>
  </div>

  <%- include('partials/legal-footer') %>

  <script src="/js/password-toggle.js"></script>
</body>
</html>

NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://localhost/luo2english
SESSION_SECRET=your-secret-key-change-this-in-production

# Password reset email (SMTP). Without SMTP_HOST, reset links are logged in
# development and sending fails in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Luo2English <no-reply@swiftener.com>

# Public base URL used in password reset links. Defaults to the request host.
APP_URL=https://swiftener.com

# Trust the local reverse proxy so req.ip and rate limiting see real client IPs.
TRUST_PROXY=loopback

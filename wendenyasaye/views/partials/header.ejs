<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#264d43">
  <title><%= title %> | Wende Nyasaye</title>
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="stylesheet" href="/style.css">
  <script src="/app.js" defer></script>
</head>
<body>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href="/"><span class="brand-mark"><svg class="icon" aria-hidden="true"><use href="/icons.svg#music"></use></svg></span><span class="brand-copy">Wende Nyasaye <span>Dholuo hymn directory</span></span></a>
      <nav aria-label="Main navigation">
        <a href="/">Hymns</a>
        <a href="/composers">Composers</a>
        <a href="/categories">Categories</a>
        <% if (user) { %>
          <% if (user.role === 'admin') { %><a href="/admin">Admin</a><a href="/admin/users">Users</a><% } %>
          <a href="/profile">Profile</a>
          <form method="post" action="/logout" id="logout-form">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <button class="nav-button" type="submit">Sign out</button>
          </form>
        <% } else { %>
          <a href="/login">Sign in</a>
          <a href="/register">Create account</a>
        <% } %>
      </nav>
    </div>
  </header>
  <main class="wrap">

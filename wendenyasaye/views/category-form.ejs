<%- include('partials/header') %>
<section class="form-card">
  <p class="eyebrow">Admin</p><h1>Edit category</h1>
  <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
  <form method="post" action="/admin/categories/<%= category.id %>/edit" class="stack">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label>Name<input name="name" value="<%= category.name %>" maxlength="100" required></label>
    <button class="button" type="submit">Save category</button>
  </form>
  <p><a href="/admin/categories">Cancel</a></p>
</section>
<%- include('partials/footer') %>

<%- include('partials/header') %>
<section class="form-card">
  <p class="eyebrow">Your account</p>
  <h1>Edit profile</h1>
  <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
  <form method="post" action="/profile/edit" class="stack">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label>Email<input type="email" name="email" value="<%= email %>" maxlength="254" required autocomplete="email"></label>
    <label>Current password<input type="password" name="password" required autocomplete="current-password"></label>
    <button class="button" type="submit">Save profile</button>
  </form>
  <p><a href="/profile">Cancel</a></p>
</section>
<%- include('partials/footer') %>

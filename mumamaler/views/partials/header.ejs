<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#263e36">
  <title><%= title %> | Muma Maler</title>
  <link rel="stylesheet" href="/style.css">
  <script src="/search.js" defer></script>
</head>
<body>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href="/"><span class="brand-mark" aria-hidden="true"><svg class="icon"><use href="/icons.svg#book"></use></svg></span><span class="brand-copy">Muma Maler <span>Luo Bible</span></span></a>
      <nav aria-label="Main navigation">
        <a href="/">Books</a>
        <a href="/search">Search scripture</a>
        <a href="/authors">Authors</a>
        <a href="/categories">Categories</a>
        <a href="/testaments/old">Old Testament</a>
        <a href="/testaments/new">New Testament</a>
        <% if (reader) { %>
          <a href="/profile">Profile</a>
          <a href="/bookmarks">Bookmarks</a>
          <% if (admin) { %><a href="/admin">Admin</a><a href="/admin/readers">Users</a><% } %>
          <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="nav-button">Sign out</button></form>
        <% } else { %>
          <a href="/login">Sign in</a>
          <a href="/register">Create account</a>
        <% } %>
      </nav>
    </div>
  </header>
  <main class="wrap">

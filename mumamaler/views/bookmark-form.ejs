<%- include('partials/header') %>
<section class="form-card">
  <p class="eyebrow">Bookmark</p>
  <h1>Edit bookmark</h1>
  <p><a href="/books/<%= encodeURIComponent(bookmark.book_slug) %>/chapters/<%= encodeURIComponent(bookmark.chapter_slug) %>"><%= bookmark.book_name %> <%= bookmark.number %></a></p>
  <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
  <form method="post" action="/books/<%= encodeURIComponent(bookmark.book_slug) %>/chapters/<%= encodeURIComponent(bookmark.chapter_slug) %>/bookmark/edit" class="stack">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label>Note<textarea name="note" rows="5" maxlength="5000"><%= bookmark.note %></textarea></label>
    <label>Tags (comma-separated)<input type="text" name="tags" maxlength="500" value="<%= bookmark.tags %>"></label>
    <button class="button">Save bookmark</button>
  </form>
  <p><a href="/bookmarks">Back to bookmarks</a></p>
</section>
<%- include('partials/footer') %>
